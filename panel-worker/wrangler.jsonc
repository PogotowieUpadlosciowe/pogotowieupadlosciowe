{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogotowie-upadlosciowe-panel-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "../panel-v2",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_ORIGIN": "https://pogotowieupadlosciowe-api-v2.pogotowieupadlosciowe.workers.dev",
    "ADMIN_DISPLAY_NAME": "Mariusz",
    "OPERATOR_DISPLAY_NAME": "Ania"
  }
}
