{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pogotowie-upadlosciowe-panel-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "keep_vars": true,
  "assets": {
    "directory": "../panel-v2",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_ORIGIN": "https://api.pogotowieupadlosciowe.pl",
    "ACCESS_TEAM_DOMAIN": "gentle-term-b8a9.cloudflareaccess.com",
    "ACCESS_AUD": "09d8fadb98af8c82432a1c33591e6a1bdc1345e277ffd0797ea489ed4a009b12",
    "ADMIN_DISPLAY_NAME": "Mariusz",
    "OPERATOR_DISPLAY_NAME": "Ania"
  }
}
